    "C_level": [
      {
        "id": "C1.1.1",
        "anchor": "P6",
        "text": "以元丰二十三路为准，今湖北地跨五路",
        "sources": [
          "M4"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.2",
        "anchor": "P6",
        "text": "湖北共18府州军，重要产茶区10个占比55%",
        "sources": [
          "M5",
          "M6",
          "M7",
          "M8",
          "M9",
          "M10"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.3",
        "anchor": "P6",
        "text": "蕲州三场黄州麻城场属十三山场产茶区",
        "sources": [
          "M11"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.4",
        "anchor": "P6",
        "text": "景祐间全国三分之一州军产茶，湖北比例更高",
        "sources": [
          "M12"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.5",
        "anchor": "P6",
        "text": "茶叶分片茶散茶，荆湖产出岳麓草子杨树雨前等",
        "sources": [
          "M13",
          "M14",
          "M15"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.6",
        "anchor": "P7",
        "text": "鄂州江陵府蕲州三场茶叶种类丰富",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.7",
        "anchor": "P7",
        "text": "全国茶产量因史料散佚难以精确",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.8",
        "anchor": "P7",
        "text": "湖北除夔州施州外行榷茶法便于计算",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.9",
        "anchor": "P8",
        "text": "夔州路未入榷茶体系始终行税茶",
        "sources": [
          "M16",
          "M17"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.10",
        "anchor": "P8",
        "text": "《东斋记事》未列施州产茶故不计",
        "sources": [
          "M18"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.11",
        "anchor": "P8",
        "text": "折税茶独立于买茶额外，天禧末全国76万余斤",
        "sources": [
          "M19",
          "M20",
          "M21"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.12",
        "anchor": "P8",
        "text": "湖北纳耗率27.5%耗茶约278万斤",
        "sources": [
          "M22"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.13",
        "anchor": "P8",
        "text": "水磨茶行于元丰京师，贡茶仅江陵碧涧芽600斤",
        "sources": [
          "M23",
          "M24"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.14",
        "anchor": "P8",
        "text": "食茶计入买茶额，私茶估为买茶额半数至持平",
        "sources": [
          "M25",
          "M26",
          "M27"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.15",
        "anchor": "P8",
        "text": "湖北茶产保守1290万斤含私茶最高2300万斤",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.2.1",
        "anchor": "P10",
        "text": "市场分汴京东南蜀川关陇四域，湖北水网连四方",
        "sources": [
          "M35"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.2",
        "anchor": "P10",
        "text": "茶法分禁榷通商卖引，贴射法归属存争议",
        "sources": [
          "M32"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.3",
        "anchor": "P10",
        "text": "湖北榷茶始自建隆刘湛蕲春，乾德苏晓置十四场",
        "sources": [
          "M28",
          "M29"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.4",
        "anchor": "P10",
        "text": "太平兴国二年六榷务十三茶场确立",
        "sources": [
          "M30"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.5",
        "anchor": "P10",
        "text": "雍熙交引使茶贩西北，政和茶法以长短引规制",
        "sources": [
          "M31",
          "M33",
          "M34"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.6",
        "anchor": "P11",
        "text": "嘉祐四年通商法推行官府撤出流通",
        "sources": [
          "M36"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.7",
        "anchor": "P11",
        "text": "茶法嬗变使湖北茶市呈榷茶通商两阶段差异",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.3.1",
        "anchor": "P13",
        "text": "官府轻估入重估出商人贩西北获利厚",
        "sources": [
          "M37"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.2",
        "anchor": "P13",
        "text": "茶利由品质决定亦受路途影响",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.3",
        "anchor": "P14",
        "text": "榷茶阶段湖北茶主销本地",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.4",
        "anchor": "P14",
        "text": "官购价与售价差悬殊，兴国军片茶40文售800文",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.5",
        "anchor": "P14",
        "text": "片茶价高于散茶，品质决定利润",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C2.1.1",
        "anchor": "P2",
        "text": "饮茶兴于唐盛于宋，茶叶为百姓日用必需品",
        "sources": [
          "M1",
          "M2"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.2",
        "anchor": "P2",
        "text": "茶盐之法系朝廷利柄，茶叶经济是国家财政重要组成",
        "sources": [
          "M3"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.3",
        "anchor": "P2",
        "text": "宋代茶叶经济研究有茶法、产茶额、影响、地区茶业四种倾向",
        "sources": [],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.4",
        "anchor": "P2",
        "text": "鲜有学者系统讨论北宋今湖北地区茶叶经济",
        "sources": [],
        "parent": "B2.1"
      },
      {
