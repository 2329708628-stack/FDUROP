    "C_level": [
      {
        "id": "C1.1.1",
        "anchor": "P6",
        "text": "北宋以元丰年间二十三路为标准，今湖北地跨京西南路、荆湖北路、淮南西路、江南西路、夔州路",
        "sources": [
          "M4"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.2",
        "anchor": "P6",
        "text": "属今湖北地区的府州军共18个，分布于五路之中",
        "sources": [
          "M5",
          "M6",
          "M7",
          "M8"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.3",
        "anchor": "P6",
        "text": "湖北地区重要产茶区共10府州军，在域内占比达55%",
        "sources": [
          "M9",
          "M10"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.4",
        "anchor": "P6",
        "text": "蕲州三场和黄州麻城场属十三山场产茶区",
        "sources": [
          "M11"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.5",
        "anchor": "P6",
        "text": "景祐元年全国三分之一的州军为产茶州军，湖北地区远高于此比例",
        "sources": [
          "M12"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.6",
        "anchor": "P6",
        "text": "北宋茶叶分片茶与散茶两类，荆湖地区产出岳麓、草子、杨树、雨前等品种",
        "sources": [
          "M13",
          "M14",
          "M15"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.7",
        "anchor": "P7",
        "text": "北宋鄂州、江陵府与蕲州三场茶叶种类较为丰富且质量上乘",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.8",
        "anchor": "P7",
        "text": "北宋全国茶叶产量难以精确，因地方史料散佚与计量单位屡经更易",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.9",
        "anchor": "P7",
        "text": "湖北地区除夔州路施州外概行榷茶法，便于统一计算产量",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.10",
        "anchor": "P8",
        "text": "夔州路终北宋一朝未被纳入榷茶体系，始终践行税茶政策",
        "sources": [
          "M16",
          "M17"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.11",
        "anchor": "P8",
        "text": "范镇《东斋记事》所列蜀地八处产茶未含施州，施州产茶量极低",
        "sources": [
          "M18"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.12",
        "anchor": "P8",
        "text": "折税茶独立于买茶额之外，民岁输税愿折茶者称折税茶",
        "sources": [
          "M19",
          "M20"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.13",
        "anchor": "P8",
        "text": "北宋折税茶变化显著，天禧末年全国降至76万余斤",
        "sources": [
          "M21"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.14",
        "anchor": "P8",
        "text": "北宋官府规定每百斤纳耗二十至三十五斤，湖北取27.5%纳耗率",
        "sources": [
          "M22"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.15",
        "anchor": "P8",
        "text": "水磨茶法于元丰年间在京师周围地区实行",
        "sources": [
          "M23"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.16",
        "anchor": "P8",
        "text": "江陵府贡茶数量较少，仅贡碧涧茶芽六百斤",
        "sources": [
          "M24"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.17",
        "anchor": "P8",
        "text": "食茶系官府收购后转售民户之茶，已计入买茶额",
        "sources": [
          "M25"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.18",
        "anchor": "P8",
        "text": "北宋私茶问题严峻，产茶州县铺户多私自种植交易",
        "sources": [
          "M26"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.19",
        "anchor": "P8",
        "text": "官府遣御史禁绝私茶，私茶估定为买茶额半数至持平",
        "sources": [
          "M27"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.20",
        "anchor": "P8",
        "text": "湖北地区茶叶总产量保守计算约1290万斤，含私茶最高可达2300万斤",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.2.1",
        "anchor": "P10",
        "text": "北宋商业市场分为汴京、东南、蜀川、关陇四域，湖北凭借水网联结四方",
        "sources": [
          "M35"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.2",
        "anchor": "P10",
        "text": "北宋茶法可分为禁榷、通商、卖引法阶段，学界多按官府与市场权利分配划分",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.3",
        "anchor": "P10",
        "text": "贴射法因部分通商，其归属榷茶或通商尚存争议",
        "sources": [
          "M32"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.4",
        "anchor": "P10",
        "text": "湖北地区榷茶始自建隆年间刘湛奉召榷茶于蕲春",
        "sources": [
          "M28"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.5",
        "anchor": "P10",
        "text": "乾德三年苏晓榷蕲黄舒庐寿五州茶置十四场，岁入百余万缗",
        "sources": [
          "M29"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.6",
        "anchor": "P10",
        "text": "六榷务十三茶场体系于太平兴国二年正式确立",
        "sources": [
          "M30"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.7",
        "anchor": "P10",
        "text": "雍熙年间行交引法，商人输刍粮塞下换茶引，茶叶转贩西北",
        "sources": [
          "M31"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.8",
        "anchor": "P10",
        "text": "政和茶法通过长短引规制商人贸易，短引限本路一季、长引许跨路一年",
        "sources": [
          "M33",
          "M34"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.9",
        "anchor": "P11",
        "text": "嘉祐四年正式推行通商法，官府大规模撤出茶叶流通领域仅保留管理职能",
        "sources": [
          "M36"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.10",
        "anchor": "P11",
        "text": "北宋茶法嬗变使湖北茶叶市场在采购、运输和销售上呈现榷茶与通商两阶段差异",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.3.1",
        "anchor": "P13",
        "text": "北宋茶叶属经济作物，官府轻估买入重估卖出，商人转贩西北获利特厚",
        "sources": [
          "M37"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.2",
        "anchor": "P13",
        "text": "茶叶利润多寡主要由品质决定，亦受路途远近影响",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.3",
        "anchor": "P14",
        "text": "榷茶阶段湖北茶叶主要销于本地，鲜有远销黄河以北",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.4",
        "anchor": "P14",
        "text": "官府收购价与销售价差距悬殊，兴国军片茶收购40文转售真州达800文",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.5",
        "anchor": "P14",
        "text": "片茶收购与销售价格普遍高于散茶",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.6",
        "anchor": "P14",
        "text": "茶叶销售价格以品质等级为决定因素，较高等级即使本地销售亦可获厚利",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C2.1.1",
        "anchor": "P2",
        "text": "饮茶之风兴于唐而盛于宋，茶叶成为百姓每日不可阙的日用品",
        "sources": [
          "M1",
          "M2"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.2",
        "anchor": "P2",
        "text": "北宋官府将茶叶系统纳入赋税体系，茶盐之法系朝廷利柄",
        "sources": [
          "M3"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.3",
        "anchor": "P2",
        "text": "学界对宋代茶叶经济研究呈四种倾向：茶法阐释、产茶额考证、影响研究、地区茶业经济",
        "sources": [],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.4",
        "anchor": "P2",
        "text": "鲜有学者对北宋时期今湖北地区茶叶经济进行系统讨论",
        "sources": [],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.5",
        "anchor": "P18",
        "text": "北宋官府为充盈国帑支撑边疆战事，对茶利给予高度重视",
        "sources": [
          "M39"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.6",
        "anchor": "P18",
        "text": "鄂州崇阳县民不务耕织唯以植茶为业，反映民众植茶积极性高涨",
        "sources": [
          "M38"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.7",
        "anchor": "P18",
        "text": "北宋文人士大夫拓展分茶斗茶等娱乐活动并推广茶文化",
        "sources": [
          "M40"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.2.1",
        "anchor": "P20",
        "text": "陆羽与赵佶均论及茶树生长环境，上者生烂石、崖必阳圃必阴",
        "sources": [
          "M41"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.2",
        "anchor": "P20",
        "text": "蔡襄《茶录》记载茶树植产之地的适宜条件",
        "sources": [
          "M42"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.3",
        "anchor": "P20",
        "text": "湖北山地丘陵地貌为茶树生长提供了富含有机质的土壤",
        "sources": [],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.4",
        "anchor": "P20",
        "text": "北宋时期气候整体偏暖，温度较今高0.3至0.5度，更适宜茶叶生长",
        "sources": [],
        "parent": "B2.2"
      },
      {
        "id": "C2.3.1",
        "anchor": "P22",
        "text": "湖北水网纵横，长江汉江交汇形成以鄂州、汉阳军、江陵府为多中心的水运网络",
        "sources": [
          "M43"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.2",
        "anchor": "P22",
        "text": "江陵府作为榷货务受纳潭鼎澧岳归峡等路片茶散茶共八十七万余斤再分销全国",
        "sources": [
          "M44"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.3",
        "anchor": "P22",
        "text": "复州北至郢州私路二百五十里官路三百里，江汉平原形成陆运通道",
        "sources": [
          "M45"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.4",
        "anchor": "P22",
        "text": "湖北居国家中心地带，东西方向长江贯通、南北方向为广南至京师枢纽",
        "sources": [],
        "parent": "B2.3"
      },
      {
        "id": "C3.1.1",
        "anchor": "P26",
        "text": "乾德二年京师建安汉阳蕲口并置场榷茶，黄州江陵府蕲州襄州复州均设榷茶场",
        "sources": [
          "M46"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.2",
        "anchor": "P26",
        "text": "大中祥符间茶商因泥水阻滞借路取真扬州转江般运蕲口等处茶货",
        "sources": [
          "M47"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.3",
        "anchor": "P26",
        "text": "仁宗令水路般运蕲口等五处茶货取东路经过上京者依汉阳榷务例",
        "sources": [
          "M49"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.4",
        "anchor": "P26",
        "text": "襄州地处湖北北部属京西南路，水运条件欠佳致其在茶叶贸易中处辅助地位",
        "sources": [
          "M48"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.5",
        "anchor": "P26",
        "text": "鄂州与汉阳军隔江相望位于江汉平原汉江汇入长江区域，水路便利舟车辐辏",
        "sources": [
          "M50"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.6",
        "anchor": "P26",
        "text": "汉阳军熙宁四年废为县属鄂州，元祐元年复置军直至北宋灭亡",
        "sources": [
          "M51"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.7",
        "anchor": "P26",
        "text": "江陵府与汉阳军鄂州形成双核心沿江经济带，塑造了湖北茶叶经贸产业集聚区域",
        "sources": [],
        "parent": "B3.1"
      },
      {
        "id": "C3.2.1",
        "anchor": "P28",
        "text": "北宋官府通过控制茶叶生产运输销售各环节使茶利成为国家税收重要来源",
        "sources": [],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.2",
        "anchor": "P29",
        "text": "景德年间茶税元年旧法569万贯、二年新法410万贯、三年285万贯",
        "sources": [
          "M52"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.3",
        "anchor": "P29",
        "text": "天禧末年国家财政总收入仅2650余万贯，茶利在财政结构中地位可观",
        "sources": [
          "M53"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.4",
        "anchor": "P29",
        "text": "通商法时期园户种茶者官收租钱，六路租茶通商岁计33万余贯",
        "sources": [
          "M54"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.5",
        "anchor": "P29",
        "text": "湖北茶税独当全国十万二千余贯，鄂州一地占全国茶税约一成",
        "sources": [
          "M55"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.6",
        "anchor": "P29",
        "text": "北宋商税肇自太祖首定商税则例，累朝守为家法",
        "sources": [
          "M56"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.7",
        "anchor": "P29",
        "text": "湖北地区产茶府州军独占1府9州，茶产量达千万余斤",
        "sources": [],
        "parent": "B3.2"
      },
      {
        "id": "C3.3.1",
        "anchor": "P31",
        "text": "茶叶经济为民众开辟多元就业途径，大量农民转为茶园户",
        "sources": [],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.2",
        "anchor": "P31",
        "text": "城镇茶坊林立兼具人际交往休闲娱乐功能，创造了大量就业机会",
        "sources": [],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.3",
        "anchor": "P31",
        "text": "斗茶活动借茶叶流通传入湖北，提高了民众文化生活品质",
        "sources": [
          "M57"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.4",
        "anchor": "P31",
        "text": "官府频更茶法旧纳茶税今变租钱，致使茶农生存环境恶化",
        "sources": [
          "M58"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.5",
        "anchor": "P31",
        "text": "通商法时期荆湖茶园户赋税仍重，破产亡家或举族而逃或自经而死",
        "sources": [
          "M59"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.6",
        "anchor": "P31",
        "text": "大茶园户兼并个体茶户垄断茶叶贸易，优化生产结构但加剧兼并",
        "sources": [
          "M60"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.7",
        "anchor": "P31",
        "text": "真宗感叹贫民一旦破产即可能聚为寇盗影响社会治安",
        "sources": [
          "M61"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.8",
        "anchor": "P31",
        "text": "通商法时期小商所贩至少大商绝不通行，茶商利益被不断侵占",
        "sources": [
          "M62"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.9",
        "anchor": "P31",
        "text": "湖北茶商群聚暴横被籍为兵号茶商军，实为彼时社会危害",
        "sources": [
          "M63"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C0.1",
        "anchor": "P33",
        "text": "北宋湖北地区茶叶年产量至少逾一千三百余万斤",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.2",
        "anchor": "P33",
        "text": "茶叶经济通过茶利及商税增益政府财源，亦影响地方民生状态",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.3",
        "anchor": "P33",
        "text": "湖北地区茶叶经济繁盛始终与茶法息息相关，主导权归于中央",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.4",
        "anchor": "P33",
        "text": "北宋湖北茶叶经济繁盛更多是扩大财源目的所推政策的结果而非市场自发",
        "sources": [],
        "parent": "A0"
      }
    ]
  },
