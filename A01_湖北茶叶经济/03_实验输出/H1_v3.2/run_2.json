    "C_level": [
      {
        "id": "C1.1.1",
        "anchor": "P6",
        "text": "北宋以元丰二十三路为准，今湖北地跨京西南、荆湖北、淮南西、江南西、夔州五路",
        "sources": [
          "M4"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.2",
        "anchor": "P6",
        "text": "湖北地区共18府州军，其中重要产茶区10个占比55%",
        "sources": [
          "M5",
          "M6",
          "M7",
          "M8",
          "M9",
          "M10"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.3",
        "anchor": "P6",
        "text": "蕲州三场与黄州麻城场属十三山场产茶区",
        "sources": [
          "M11"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.4",
        "anchor": "P6",
        "text": "景祐间全国三分之一州军产茶，湖北比例远高于此",
        "sources": [
          "M12"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.5",
        "anchor": "P6",
        "text": "北宋茶叶分片茶散茶，荆湖产出岳麓草子杨树雨前等品种",
        "sources": [
          "M13",
          "M14",
          "M15"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.6",
        "anchor": "P7",
        "text": "鄂州江陵府蕲州三场茶叶种类丰富质量上乘",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.7",
        "anchor": "P7",
        "text": "北宋全国茶产量因史料散佚和计量单位变更难以精确",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.8",
        "anchor": "P7",
        "text": "湖北除夔州路施州外概行榷茶法便于统一计算",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.9",
        "anchor": "P8",
        "text": "夔州路终北宋未入榷茶体系，始终行税茶政策",
        "sources": [
          "M16",
          "M17"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.10",
        "anchor": "P8",
        "text": "《东斋记事》未列施州产茶，施州产茶量极低不计",
        "sources": [
          "M18"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.11",
        "anchor": "P8",
        "text": "折税茶独立于买茶额之外，天禧末全国降至76万余斤",
        "sources": [
          "M19",
          "M20",
          "M21"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.12",
        "anchor": "P8",
        "text": "湖北纳耗率取27.5%，耗茶约278万斤",
        "sources": [
          "M22"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.13",
        "anchor": "P8",
        "text": "水磨茶法元丰间行于京师周围，贡茶仅江陵府碧涧茶芽六百斤",
        "sources": [
          "M23",
          "M24"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.14",
        "anchor": "P8",
        "text": "食茶已计入买茶额，私茶估定为买茶额半数至持平",
        "sources": [
          "M25",
          "M26",
          "M27"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.15",
        "anchor": "P8",
        "text": "湖北茶叶总产量保守约1290万斤，含私茶最高2300万斤",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.2.1",
        "anchor": "P10",
        "text": "北宋市场分汴京东南蜀川关陇四域，湖北凭水网联结四方",
        "sources": [
          "M35"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.2",
        "anchor": "P10",
        "text": "茶法分禁榷通商卖引阶段，贴射法归属存争议",
        "sources": [
          "M32"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.3",
        "anchor": "P10",
        "text": "湖北榷茶始自建隆刘湛蕲春榷茶，乾德苏晓置十四场岁入百万缗",
        "sources": [
          "M28",
          "M29"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.4",
        "anchor": "P10",
        "text": "太平兴国二年六榷务十三茶场体系确立",
        "sources": [
          "M30"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.5",
        "anchor": "P10",
        "text": "雍熙交引法使茶叶转贩西北，政和茶法以长短引规制贸易",
        "sources": [
          "M31",
          "M33",
          "M34"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.6",
        "anchor": "P11",
        "text": "嘉祐四年通商法推行，官府撤出流通仅留管理职能",
        "sources": [
          "M36"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.7",
        "anchor": "P11",
        "text": "茶法嬗变使湖北茶叶市场在采购运输销售上呈榷茶通商两阶段差异",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.3.1",
        "anchor": "P13",
        "text": "官府轻估入重估出，商人转贩西北获利特厚",
        "sources": [
          "M37"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.2",
        "anchor": "P13",
        "text": "茶叶利润主要由品质决定，亦受路途影响",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.3",
        "anchor": "P14",
        "text": "榷茶阶段湖北茶主要销本地，收购价销售价差悬殊",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.4",
        "anchor": "P14",
        "text": "兴国军片茶收购40文转售真州800文，价差达20倍",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.5",
        "anchor": "P14",
        "text": "片茶价格普遍高于散茶，品质等级决定利润",
        "sources": [],
        "parent": "B1.3"
      },
      {
        "id": "C2.1.1",
        "anchor": "P2",
        "text": "饮茶之风盛于宋，茶叶成为百姓每日不可或缺的日用品",
        "sources": [
          "M1",
          "M2"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.2",
        "anchor": "P2",
        "text": "北宋官府将茶盐之法视为朝廷利柄，茶叶经济是国家财政重要组成",
        "sources": [
          "M3"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.3",
        "anchor": "P2",
        "text": "学界对宋代茶叶经济研究分茶法、产茶额、影响、地区茶业四种倾向",
        "sources": [],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.4",
        "anchor": "P2",
        "text": "鲜有学者系统讨论北宋今湖北地区茶叶经济",
        "sources": [],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.5",
        "anchor": "P18",
        "text": "官府倚重茶利支撑边疆战事和皇室开支",
        "sources": [
          "M39"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.6",
        "anchor": "P18",
        "text": "鄂州崇阳县民唯以植茶为业，植茶积极性高",
        "sources": [
          "M38"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.7",
        "anchor": "P18",
        "text": "士大夫拓展分茶斗茶等活动推广茶文化",
        "sources": [
          "M40"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.2.1",
        "anchor": "P20",
        "text": "陆羽赵佶论茶树宜生烂石、崖阳圃阴",
        "sources": [
          "M41"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.2",
        "anchor": "P20",
        "text": "湖北山地丘陵提供富含有机质土壤",
        "sources": [
          "M42"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.3",
        "anchor": "P20",
        "text": "北宋气候偏暖较今高0.3-0.5度更宜茶生长",
        "sources": [],
        "parent": "B2.2"
      },
      {
        "id": "C2.3.1",
        "anchor": "P22",
        "text": "长江汉江交汇形成鄂州汉阳军江陵府多中心水运网",
        "sources": [
          "M43"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.2",
        "anchor": "P22",
        "text": "江陵府榷货务受纳潭鼎等路茶87万余斤分销全国",
        "sources": [
          "M44"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.3",
        "anchor": "P22",
        "text": "复州北至郢州私路250里官路300里，江汉平原有陆运通道",
        "sources": [
          "M45"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.4",
        "anchor": "P22",
        "text": "湖北居国家中心，东西长江贯通南北为广南至京师枢纽",
        "sources": [],
        "parent": "B2.3"
      },
      {
        "id": "C3.1.1",
        "anchor": "P26",
        "text": "乾德二年置场榷茶，黄州江陵蕲州襄州复州均设榷场",
        "sources": [
          "M46"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.2",
        "anchor": "P26",
        "text": "大中祥符间茶商借路转江般运蕲口等处茶货",
        "sources": [
          "M47"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.3",
        "anchor": "P26",
        "text": "仁宗令水路般运五处茶货取东路上京依汉阳例",
        "sources": [
          "M49"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.4",
        "anchor": "P26",
        "text": "襄州水运欠佳在茶叶贸易中处辅助地位",
        "sources": [
          "M48"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.5",
        "anchor": "P26",
        "text": "鄂州汉阳军隔江相望水路便利舟车辐辏",
        "sources": [
          "M50"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.6",
        "anchor": "P26",
        "text": "汉阳军熙宁废县元祐复军直至北宋亡",
        "sources": [
          "M51"
        ],
        "parent": "B3.1"
      },
      {
        "id": "C3.1.7",
        "anchor": "P26",
        "text": "江陵府与汉阳军鄂州形成双核心沿江经济带",
        "sources": [],
        "parent": "B3.1"
      },
      {
        "id": "C3.2.1",
        "anchor": "P28",
        "text": "官府控制产销运各环节使茶利成国家税收重要来源",
        "sources": [],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.2",
        "anchor": "P29",
        "text": "景德间茶税旧法569万贯新法410万贯285万贯",
        "sources": [
          "M52"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.3",
        "anchor": "P29",
        "text": "天禧末财政总收入2650万贯，茶利地位可观",
        "sources": [
          "M53"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.4",
        "anchor": "P29",
        "text": "通商法园户种茶官收租钱，六路租茶岁计33万余贯",
        "sources": [
          "M54"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.5",
        "anchor": "P29",
        "text": "湖北茶税10万余贯，鄂州占全国约一成",
        "sources": [
          "M55"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.2.6",
        "anchor": "P29",
        "text": "商税肇自太祖守为家法，湖北茶相关产业纳税",
        "sources": [
          "M56"
        ],
        "parent": "B3.2"
      },
      {
        "id": "C3.3.1",
        "anchor": "P31",
        "text": "茶叶经济开辟多元就业，大量农民转茶园户",
        "sources": [],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.2",
        "anchor": "P31",
        "text": "城镇茶坊林立创造大量就业机会",
        "sources": [],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.3",
        "anchor": "P31",
        "text": "斗茶传入湖北提高民众文化品质",
        "sources": [
          "M57"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.4",
        "anchor": "P31",
        "text": "官府频更茶法致茶农生存环境恶化",
        "sources": [
          "M58"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.5",
        "anchor": "P31",
        "text": "通商法荆湖茶园户赋税重，破产逃亡或自尽",
        "sources": [
          "M59"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.6",
        "anchor": "P31",
        "text": "大茶园户兼并个体茶户垄断贸易",
        "sources": [
          "M60"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.7",
        "anchor": "P31",
        "text": "贫民破产可能聚为寇盗影响治安",
        "sources": [
          "M61"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.8",
        "anchor": "P31",
        "text": "通商法小商贩少大商不通，茶商利益被侵",
        "sources": [
          "M62"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C3.3.9",
        "anchor": "P31",
        "text": "湖北茶商群聚暴横被籍为兵号茶商军",
        "sources": [
          "M63"
        ],
        "parent": "B3.3"
      },
      {
        "id": "C0.1",
        "anchor": "P33",
        "text": "北宋湖北茶叶年产量至少逾1300万斤",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.2",
        "anchor": "P33",
        "text": "茶叶经济增益政府财源并影响地方民生",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.3",
        "anchor": "P33",
        "text": "湖北茶叶经济繁盛与茶法息息相关，主导权在中央",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.4",
        "anchor": "P33",
        "text": "湖北茶业繁盛是扩大财源政策结果而非市场自发",
        "sources": [],
        "parent": "A0"
      }
    ]
  },
