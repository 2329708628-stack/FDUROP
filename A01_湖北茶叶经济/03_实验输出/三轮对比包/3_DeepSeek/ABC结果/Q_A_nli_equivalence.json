      "members": [
        {
          "atom": "human_C1.3.3",
          "run": "human",
          "node_id": "C1.3.3",
          "text": "榷茶阶段湖北茶叶主要销售地仍为本区鲜有远销黄河以北者",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c41",
      "members": [
        {
          "atom": "human_C1.3.4",
          "run": "human",
          "node_id": "C1.3.4",
          "text": "官府收购价与销售价差距悬殊如兴国军两府号片茶由四十文升至八百文",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c42",
      "members": [
        {
          "atom": "human_C1.3.5",
          "run": "human",
          "node_id": "C1.3.5",
          "text": "片茶收购与销售价格普遍高于散茶如第一号一百六十五文远高于散茶草子",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c43",
      "members": [
        {
          "atom": "human_C1.3.6",
          "run": "human",
          "node_id": "C1.3.6",
          "text": "茶叶售价虽受转运道里影响然品质等级实为决定因素",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c44",
      "members": [
        {
          "atom": "human_C2.1.1",
          "run": "human",
          "node_id": "C2.1.1",
          "text": "饮茶之风兴于唐盛于宋至北宋始为世重",
          "sources": [
            "M1"
          ]
        }
      ]
    },
    {
      "concept_id": "c45",
      "members": [
        {
          "atom": "human_C2.1.2",
          "run": "human",
          "node_id": "C2.1.2",
          "text": "茶叶已是盖人家每日不可阙者成为日常必需品",
          "sources": [
            "M2"
          ]
        }
      ]
    },
    {
      "concept_id": "c46",
      "members": [
        {
          "atom": "human_C2.1.3",
          "run": "human",
          "node_id": "C2.1.3",
          "text": "官府对茶利的倚重与民间饮茶风尚共同驱动湖北农民广泛植茶",
          "sources": [
            "M38"
          ]
        }
      ]
    },
    {
      "concept_id": "c47",
      "members": [
        {
          "atom": "human_C2.1.4",
          "run": "human",
          "node_id": "C2.1.4",
          "text": "鄂州崇阳县多旷土民不务耕织唯以植茶为业",
          "sources": [
            "M38"
          ]
        }
      ]
    },
    {
      "concept_id": "c48",
      "members": [
        {
          "atom": "human_C2.1.5",
          "run": "human",
          "node_id": "C2.1.5",
          "text": "谏官余靖指天下二税不足供军故茶盐酒税山泽杂产之利尽归于官",
          "sources": [
            "M39"
          ]
        }
      ]
    },
    {
      "concept_id": "c49",
      "members": [
        {
          "atom": "human_C2.1.6",
          "run": "human",
          "node_id": "C2.1.6",
          "text": "北宋长期保持大量军队官府为保军需持续鼓励民众种植茶叶等高价值作物",
          "sources": [
            "M39"
          ]
        }
      ]
    },
    {
      "concept_id": "c50",
      "members": [
        {
          "atom": "human_C2.1.7",
          "run": "human",
          "node_id": "C2.1.7",
          "text": "宋徽宗时期湖北恢复榷茶鼓励植茶其意更在满足皇室用度",
          "sources": [
            "M38"
          ]
        }
      ]
    },
    {
      "concept_id": "c51",
      "members": [
        {
          "atom": "human_C2.1.8",
          "run": "human",
          "node_id": "C2.1.8",
          "text": "蔡條称茶之尚自唐人始至本朝为盛至祐陵时益穷极新出",
          "sources": [
            "M40"
          ]
        }
      ]
    },
    {
      "concept_id": "c52",
      "members": [
        {
          "atom": "human_C2.1.9",
          "run": "human",
          "node_id": "C2.1.9",
          "text": "江陵鄂州襄阳等城茶坊林立周边草市亦有大量茶坊供百姓饮茶休闲",
          "sources": [
            "M40"
          ]
        }
      ]
    },
    {
      "concept_id": "c53",
      "members": [
        {
          "atom": "human_C2.2.2",
          "run": "human",
          "node_id": "C2.2.2",
          "text": "湖北山地丘陵居多群山既拦截水汽又为茶树提供富含有机质的土壤",
          "sources": [
            "M41",
            "M42"
          ]
        }
      ]
    },
    {
      "concept_id": "c54",
      "members": [
        {
          "atom": "human_C2.2.3",
          "run": "human",
          "node_id": "C2.2.3",
          "text": "北宋时期气候整体偏暖较今高零点三至零点五度使湖北温度更宜茶叶生长",
          "sources": [
            "M42"
          ]
        }
      ]
    },
    {
      "concept_id": "c55",
      "members": [
        {
          "atom": "human_C2.2.4",
          "run": "human",
          "node_id": "C2.2.4",
          "text": "茶树生长最适温度在十九至三十摄氏度今湖北年均气温十五至十七度",
          "sources": [
            "M42"
          ]
        }
      ]
    },
    {
      "concept_id": "c56",
      "members": [
        {
          "atom": "human_C2.3.1",
          "run": "human",
          "node_id": "C2.3.1",
          "text": "北宋承袭前代路网疏浚河道修缮驿道为湖北茶叶经济提供交通保障",
          "sources": [
            "M43"
          ]
        }
      ]
    },
    {
      "concept_id": "c57",
      "members": [
        {
          "atom": "human_C2.3.2",
          "run": "human",
          "node_id": "C2.3.2",
          "text": "湖北形成以鄂州汉阳军江陵府为多中心的水运网络且水运载量大价廉",
          "sources": [
            "M43"
          ]
        }
      ]
    },
    {
      "concept_id": "c58",
      "members": [
        {
          "atom": "human_C2.3.4",
          "run": "human",
          "node_id": "C2.3.4",
          "text": "东西向长江上中游货物经鄂州至淮南由真州向北流入京师",
          "sources": [
            "M44"
          ]
        }
      ]
    },
    {
      "concept_id": "c59",
      "members": [
        {
          "atom": "human_C2.3.6",
          "run": "human",
          "node_id": "C2.3.6",
          "text": "江陵府受纳潭鼎澧岳归峡荆南府片散茶共八十七万五千三百五十七斤",
          "sources": [
            "M45"
          ]
        }
      ]
    },
    {
      "concept_id": "c60",
      "members": [
        {
          "atom": "human_C3.1.1",
          "run": "human",
          "node_id": "C3.1.1",
          "text": "乾德二年京师建安汉阳蕲口并置场榷茶并于黄州江陵蕲州襄州复州设场",
          "sources": [
            "M46"
          ]
        }
      ]
    },
    {
      "concept_id": "c61",
      "members": [
        {
          "atom": "human_C3.1.2",
          "run": "human",
          "node_id": "C3.1.2",
          "text": "官府以行政权力使设榷场的江陵府汉阳蕲口黄州成为茶叶转运与销售核心城市",
          "sources": [
            "M46"
          ]
        }
      ]
    },
    {
      "concept_id": "c62",
      "members": [
        {
          "atom": "human_C3.1.3",
          "run": "human",
          "node_id": "C3.1.3",
          "text": "大中祥符至天圣七年茶商因泥水阻滞车牛借路取真扬高邮楚泗州只纳旧路庐寿一路税钱",
          "sources": [
            "M47"
          ]
        }
      ]
    },
    {
      "concept_id": "c63",
      "members": [
        {
          "atom": "human_C3.1.4",
          "run": "human",
          "node_id": "C3.1.4",
          "text": "仁宗令贩卖蕲口太湖洗马石桥无为军五处场务茶货依汉阳榷务茶例上京",
          "sources": [
            "M48"
          ]
        }
      ]
    },
    {
      "concept_id": "c64",
      "members": [
        {
          "atom": "human_C3.1.5",
          "run": "human",
          "node_id": "C3.1.5",
          "text": "通商阶段江陵府与汉阳军凭榷茶积累与水利条件核心地位有增无减",
          "sources": [
            "M47",
            "M48"
          ]
        }
      ]
    },
    {
      "concept_id": "c65",
      "members": [
        {
          "atom": "human_C3.1.6",
          "run": "human",
          "node_id": "C3.1.6",
          "text": "鄂州虽非六榷务十三茶场节点但因产量高种类丰而受官府与商人重视",
          "sources": [
            "M49",
            "M50"
          ]
        }
      ]
    },
    {
      "concept_id": "c66",
      "members": [
        {
          "atom": "human_C3.1.8",
          "run": "human",
          "node_id": "C3.1.8",
          "text": "鄂州与汉阳军隔江相望管下舟车辐辏共同构成沿江经济带核心之一",
          "sources": [
            "M50"
          ]
        }
      ]
    },
    {
      "concept_id": "c67",
      "members": [
        {
          "atom": "human_C3.1.9",
          "run": "human",
          "node_id": "C3.1.9",
          "text": "茶叶贸易促进船运经济并刺激沿江城镇客栈邸舍经济发展",
          "sources": [
            "M51"
          ]
        }
      ]
    },
    {
      "concept_id": "c68",
      "members": [
        {
          "atom": "human_C3.1.10",
          "run": "human",
          "node_id": "C3.1.10",
          "text": "湖北形成以江陵府为一核心汉阳军与鄂州为另一核心的双核心沿江经济带",
          "sources": [
            "M46",
            "M51"
          ]
        }
      ]
    },
    {
      "concept_id": "c69",
      "members": [
        {
          "atom": "human_C3.2.1",
          "run": "human",
          "node_id": "C3.2.1",
          "text": "茶盐之法系朝廷利柄自祖宗以来他司不敢侵紊",
          "sources": [
            "M3"
          ]
        }
      ]
    },
    {
      "concept_id": "c70",
      "members": [
        {
          "atom": "human_C3.2.2",
          "run": "human",
          "node_id": "C3.2.2",
          "text": "官府视茶叶为征榷体制重要一环使茶利成为国家税收重要来源",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c71",
      "members": [
        {
          "atom": "human_C3.2.3",
          "run": "human",
          "node_id": "C3.2.3",
          "text": "景德年间茶税旧法得五百六十九万贯新法四百一十万贯后降至二百八十五万贯",
          "sources": [
            "M52"
          ]
        }
      ]
    },
    {
      "concept_id": "c72",
      "members": [
        {
          "atom": "human_C3.2.4",
          "run": "human",
          "node_id": "C3.2.4",
          "text": "天禧末年北宋财政总收入仅二千六百五十余万贯可窥茶利在财政结构中的地位",
          "sources": [
            "M53"
          ]
        }
      ]
    },
    {
      "concept_id": "c73",
      "members": [
        {
          "atom": "human_C3.2.5",
          "run": "human",
          "node_id": "C3.2.5",
          "text": "北宋府州军监三百余个中产茶府州军九十七处而湖北独占一府九州",
          "sources": [
            "M54"
          ]
        }
      ]
    },
    {
      "concept_id": "c74",
      "members": [
        {
          "atom": "human_C3.2.7",
          "run": "human",
          "node_id": "C3.2.7",
          "text": "通商法时期令园户之种茶者官收租钱故湖北茶利仍保持较高数额",
          "sources": [
            "M56"
          ]
        }
      ]
    },
    {
      "concept_id": "c75",
      "members": [
        {
          "atom": "human_C3.2.8",
          "run": "human",
          "node_id": "C3.2.8",
          "text": "六路租茶岁计三十三万八千余贯湖北独当十万二千三百余贯鄂州约占三万九千缗",
          "sources": [
            "M56"
          ]
        }
      ]
    },
    {
      "concept_id": "c76",
      "members": [
        {
          "atom": "human_C3.2.9",
          "run": "human",
          "node_id": "C3.2.9",
          "text": "北宋商税肇自太祖首定商税则例湖北茶相关船运客店茶坊皆纳入商税体系",
          "sources": [
            "M56"
          ]
        }
      ]
    },
    {
      "concept_id": "c77",
      "members": [
        {
          "atom": "human_C3.3.1",
          "run": "human",
          "node_id": "C3.3.1",
          "text": "茶叶经济繁盛为民众开辟多元就业途径大量农民转为茶园户",
          "sources": [
            "M57"
          ]
        }
      ]
    },
    {
      "concept_id": "c78",
      "members": [
        {
          "atom": "human_C3.3.2",
          "run": "human",
          "node_id": "C3.3.2",
          "text": "城镇茶坊林立商业性饮茶场域增加创造大量就业机会",
          "sources": [
            "M57"
          ]
        }
      ]
    },
    {
      "concept_id": "c79",
      "members": [
        {
          "atom": "human_C3.3.3",
          "run": "human",
          "node_id": "C3.3.3",
          "text": "茶叶经济发展带动茶文化繁荣原盛行闽地的斗茶传入湖北",
          "sources": [
            "M58"
          ]
        }
      ]
    },
    {
      "concept_id": "c80",
      "members": [
        {
          "atom": "human_C3.3.4",
          "run": "human",
          "node_id": "C3.3.4",
          "text": "江陵汉阳夜间环境改善在文人推广下夜间饮茶习俗迅速发展",
          "sources": [
            "M58"
          ]
        }
      ]
    },
    {
      "concept_id": "c81",
      "members": [
        {
          "atom": "human_C3.3.5",
          "run": "human",
          "node_id": "C3.3.5",
          "text": "植茶本是贫民取以为利的手段亦是茶商盈利的根本",
          "sources": [
            "M59"
          ]
        }
      ]
    },
    {
      "concept_id": "c82",
      "members": [
        {
          "atom": "human_C3.3.6",
          "run": "human",
          "node_id": "C3.3.6",
          "text": "官府频更茶法旧纳茶税今变租钱致茶农与茶商生存环境恶化",
          "sources": [
            "M59"
          ]
        }
      ]
    },
    {
      "concept_id": "c83",
      "members": [
        {
          "atom": "human_C3.3.7",
          "run": "human",
          "node_id": "C3.3.7",
          "text": "通商法时期茶农赋税仍重江南荆湖茶园户破产亡家或举族而逃或自经而死",
          "sources": [
            "M60"
          ]
        }
      ]
    },
    {
      "concept_id": "c84",
      "members": [
        {
          "atom": "human_C3.3.8",
          "run": "human",
          "node_id": "C3.3.8",
          "text": "大茶园户兼并个体茶户如石桥场祖额一百七万而近岁买纳才得十万",
          "sources": [
            "M61"
          ]
        }
      ]
    },
    {
      "concept_id": "c85",
      "members": [
        {
          "atom": "human_C3.3.10",
          "run": "human",
          "node_id": "C3.3.10",
          "text": "通商法时期出现小商所贩至少大商绝不通行现象",
          "sources": [
            "M62"
          ]
        }
      ]
    },
    {
      "concept_id": "c86",
      "members": [
        {
          "atom": "human_C3.3.11",
          "run": "human",
          "node_id": "C3.3.11",
          "text": "湖北茶商群聚暴横被籍为兵号曰茶商军后多赖其用",
          "sources": [
            "M63"
          ]
        }
      ]
    },
    {
      "concept_id": "c87",
      "members": [
        {
          "atom": "model_C1.1.1",
          "run": "model",
          "node_id": "C1.1.1",
          "text": "蜀地八处产茶虽不在湖北却反映全国产茶之盛",
          "sources": [
            "M11"
          ]
        }
      ]
    },
    {
      "concept_id": "c88",
      "members": [
        {
          "atom": "model_C1.1.3",
          "run": "model",
          "node_id": "C1.1.3",
          "text": "鄂州崇阳民不务耕织唯以植茶为业显示茶叶种植专业化",
          "sources": [
            "M30"
          ]
        }
      ]
    },
    {
      "concept_id": "c89",
      "members": [
        {
          "atom": "model_C1.1.4",
          "run": "model",
          "node_id": "C1.1.4",
          "text": "茶经载上者生烂石茶录言植产崖阳圃阴反映种植科学认识",
          "sources": [
            "M33",
            "M34"
          ]
        }
      ]
    },
    {
      "concept_id": "c90",
      "members": [
        {
          "atom": "model_C1.1.5",
          "run": "model",
          "node_id": "C1.1.5",
          "text": "碧涧茶芽六百斤反映湖北地方贡茶或茶额之规模",
          "sources": [
            "M15"
          ]
        }
      ]
    },
    {
      "concept_id": "c91",
      "members": [
        {
          "atom": "model_C1.1.6",
          "run": "model",
          "node_id": "C1.1.6",
          "text": "景祐元年天下户丁三分之一为产茶州军元丰二十三路包含荆湖南北湖北居其间",
          "sources": [
            "M4",
            "M5"
          ]
        }
      ]
    },
    {
      "concept_id": "c92",
      "members": [
        {
          "atom": "model_C1.2.1",
          "run": "model",
          "node_id": "C1.2.1",
          "text": "宋初奉召榷茶于蕲春开启湖北榷茶之始",
          "sources": [
            "M19"
          ]
        }
      ]
    },
    {
      "concept_id": "c93",
      "members": [
        {
          "atom": "model_C1.2.2",
          "run": "model",
          "node_id": "C1.2.2",
