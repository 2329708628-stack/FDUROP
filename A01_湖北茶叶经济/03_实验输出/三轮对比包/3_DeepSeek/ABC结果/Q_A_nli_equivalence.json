      "members": [
        {
          "atom": "human_C1.2.4",
          "run": "human",
          "node_id": "C1.2.4",
          "text": "湖北榷茶始自建隆年间刘湛奉召榷茶于蕲春",
          "sources": [
            "M32"
          ]
        }
      ]
    },
    {
      "concept_id": "c28",
      "members": [
        {
          "atom": "human_C1.2.5",
          "run": "human",
          "node_id": "C1.2.5",
          "text": "乾德三年宋太祖采苏晓议榷蕲黄舒庐寿五州茶置十四场岁入百余万缗",
          "sources": [
            "M33"
          ]
        }
      ]
    },
    {
      "concept_id": "c29",
      "members": [
        {
          "atom": "human_C1.2.6",
          "run": "human",
          "node_id": "C1.2.6",
          "text": "十四场分布于蕲州王祺石桥洗马黄州麻城庐州王同舒州太湖罗源寿州霍山麻步开顺光州商城子安光山",
          "sources": [
            "M33"
          ]
        }
      ]
    },
    {
      "concept_id": "c30",
      "members": [
        {
          "atom": "human_C1.2.7",
          "run": "human",
          "node_id": "C1.2.7",
          "text": "太平兴国二年于江陵府襄复州无为军增置务至淳化四年废建安襄复州务",
          "sources": [
            "M34"
          ]
        }
      ]
    },
    {
      "concept_id": "c31",
      "members": [
        {
          "atom": "human_C1.2.8",
          "run": "human",
          "node_id": "C1.2.8",
          "text": "雍熙年间令商人输刍粮塞下授以交引至京师给缗钱并移文江淮荆湖给茶盐",
          "sources": [
            "M35"
          ]
        }
      ]
    },
    {
      "concept_id": "c32",
      "members": [
        {
          "atom": "human_C1.2.9",
          "run": "human",
          "node_id": "C1.2.9",
          "text": "政和二年蔡京主持制定合同场法以长短引从时空维度规制商人茶叶贸易",
          "sources": [
            "M29"
          ]
        }
      ]
    },
    {
      "concept_id": "c33",
      "members": [
        {
          "atom": "human_C1.2.10",
          "run": "human",
          "node_id": "C1.2.10",
          "text": "短引止于本路限时一季度许民赴场输息于旁近郡县便鬻",
          "sources": [
            "M30"
          ]
        }
      ]
    },
    {
      "concept_id": "c34",
      "members": [
        {
          "atom": "human_C1.2.11",
          "run": "human",
          "node_id": "C1.2.11",
          "text": "长引允许茶商销茶至他路限时一年沿路登时批发至所指地计税尽输",
          "sources": [
            "M31"
          ]
        }
      ]
    },
    {
      "concept_id": "c35",
      "members": [
        {
          "atom": "human_C1.2.12",
          "run": "human",
          "node_id": "C1.2.12",
          "text": "天圣元年仁宗采李谘议行贴射法罢官给本钱使商人与园户自相交易官收其息",
          "sources": [
            "M29",
            "M34"
          ]
        }
      ]
    },
    {
      "concept_id": "c36",
      "members": [
        {
          "atom": "human_C1.2.13",
          "run": "human",
          "node_id": "C1.2.13",
          "text": "嘉祐四年通商法正式推行园户官收租钱商贾官收征算而尽罢禁榷",
          "sources": [
            "M36"
          ]
        }
      ]
    },
    {
      "concept_id": "c37",
      "members": [
        {
          "atom": "human_C1.2.14",
          "run": "human",
          "node_id": "C1.2.14",
          "text": "茶法嬗变使采购对象运输路线与销售区域呈现榷货务与茶源地之别",
          "sources": [
            "M36"
          ]
        }
      ]
    },
    {
      "concept_id": "c38",
      "members": [
        {
          "atom": "human_C1.3.1",
          "run": "human",
          "node_id": "C1.3.1",
          "text": "凡茶入官以轻估其出以重估县官之利甚博商贾转致西北其利又特厚",
          "sources": [
            "M37"
          ]
        }
      ]
    },
    {
      "concept_id": "c39",
      "members": [
        {
          "atom": "human_C1.3.2",
          "run": "human",
          "node_id": "C1.3.2",
          "text": "表三辑录北宋湖北部分茶叶官府收购价与本地及外区出售价格",
          "sources": [
            "M37"
          ]
        }
      ]
    },
    {
