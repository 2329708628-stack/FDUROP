        {
          "atom": "human_C1.1.10",
          "run": "human",
          "node_id": "C1.1.10",
          "text": "据表二北宋官府在湖北地区买茶额为一千零十万二千七百五十三斤",
          "sources": [
            "M16"
          ]
        },
        {
          "atom": "human_C1.1.21",
          "run": "human",
          "node_id": "C1.1.21",
          "text": "湖北茶叶总产量保守计为买茶额折税茶纳耗茶与贡茶共约一千二百九十万斤",
          "sources": [
            "M16",
            "M21",
            "M22",
            "M24"
          ]
        },
        {
          "atom": "human_C2.2.1",
          "run": "human",
          "node_id": "C2.2.1",
          "text": "陆羽与赵佶均论茶树生长环境称上者生烂石且植产之地崖必阳圃必阴",
          "sources": [
            "M41"
          ]
        },
        {
          "atom": "human_C2.3.5",
          "run": "human",
          "node_id": "C2.3.5",
          "text": "南北向广南诸州自桂州由湖南北江陵荆门而至汇聚湖北",
          "sources": [
            "M44"
          ]
        },
        {
          "atom": "human_C3.2.6",
          "run": "human",
          "node_id": "C3.2.6",
          "text": "学者估算北宋茶产量至少八千万至九千万斤至多达一亿五千万斤",
          "sources": [
            "M55"
          ]
        },
        {
          "atom": "model_C1.2.6",
          "run": "model",
          "node_id": "C1.2.6",
          "text": "荆南府务受纳潭鼎澧岳归峡片散茶八十七万五千余斤",
          "sources": [
            "M37"
          ]
        },
        {
          "atom": "model_C1.3.2",
          "run": "model",
          "node_id": "C1.3.2",
          "text": "广南诸州自桂州经湖南北江陵荆门汇聚湖北",
          "sources": [
            "M36"
          ]
        },
        {
          "atom": "model_C2.1.1",
          "run": "model",
          "node_id": "C2.1.1",
          "text": "湖北地跨荆湖北路京西南路淮南西路元丰二十三路交汇",
          "sources": [
            "M4"
          ]
        },
        {
          "atom": "model_C2.1.3",
          "run": "model",
          "node_id": "C2.1.3",
          "text": "荆南鄂州汉阳蕲口皆为长江汉水水陆枢纽",
          "sources": [
            "M41",
            "M43"
          ]
        },
        {
          "atom": "model_C2.3.6",
          "run": "model",
          "node_id": "C2.3.6",
          "text": "商人输刍粮塞下得交引移文江淮荆湖给茶进一步拉动湖北茶货北输",
          "sources": [
            "M23"
          ]
        },
        {
          "atom": "model_C3.2.3",
          "run": "model",
          "node_id": "C3.2.3",
          "text": "荆湖为咽喉广南湖南北江陵荆门商路汇聚",
          "sources": [
            "M36",
            "M41"
          ]
        }
      ]
    },
    {
      "concept_id": "c2",
      "members": [
        {
          "atom": "human_C1.1.6",
          "run": "human",
          "node_id": "C1.1.6",
          "text": "湖北片茶有枕出江陵岳麓草子等散茶有龙溪雨前雨后等品类丰富",
          "sources": [
            "M14",
            "M15"
          ]
        },
        {
          "atom": "model_C1.1.2",
          "run": "model",
          "node_id": "C1.1.2",
          "text": "荆湖地区出产龙溪雨前雨后等十一等散茶品类丰富",
          "sources": [
            "M6",
            "M7"
          ]
        }
      ]
    },
    {
      "concept_id": "c3",
      "members": [
        {
          "atom": "human_C2.3.3",
          "run": "human",
          "node_id": "C2.3.3",
          "text": "复州北至郢州私路二百五十里官路三百里形成陆运通道",
          "sources": [
            "M43"
          ]
        },
        {
          "atom": "model_C1.3.1",
          "run": "model",
          "node_id": "C1.3.1",
          "text": "北至郢州私路二百五十里官路三百里显示陆路要冲",
          "sources": [
            "M35"
          ]
        }
      ]
    },
    {
      "concept_id": "c4",
      "members": [
        {
          "atom": "human_C3.1.7",
          "run": "human",
          "node_id": "C3.1.7",
          "text": "襄州地处湖北北部且郢州至襄阳尽是滩碛水运条件欠佳故降为辅助地位",
          "sources": [
            "M49",
            "M50"
          ]
        },
        {
          "atom": "model_C1.3.5",
          "run": "model",
          "node_id": "C1.3.5",
          "text": "郢州至襄阳尽是滩碛反映水运局部阻碍",
          "sources": [
            "M42"
          ]
        }
      ]
    },
    {
      "concept_id": "c5",
      "members": [
        {
          "atom": "human_C3.3.9",
          "run": "human",
          "node_id": "C3.3.9",
          "text": "宋真宗忧佣力贫民被斥去无用或聚为寇盗",
          "sources": [
            "M62"
          ]
        },
        {
          "atom": "model_C3.3.3",
          "run": "model",
          "node_id": "C3.3.3",
          "text": "佣力贫民被斥官员忧其聚为寇盗",
          "sources": [
            "M50"
          ]
        }
      ]
    },
    {
      "concept_id": "c6",
      "members": [
        {
          "atom": "human_C1.1.1",
          "run": "human",
          "node_id": "C1.1.1",
          "text": "以元丰年间所定二十三路为标准考察北宋湖北政区",
          "sources": [
            "M4"
          ]
        }
      ]
    },
    {
      "concept_id": "c7",
      "members": [
        {
          "atom": "human_C1.1.2",
          "run": "human",
          "node_id": "C1.1.2",
          "text": "今湖北在北宋地跨京西南荆湖北淮南西江南西夔州五路共十八府州军",
          "sources": [
            "M5",
            "M6",
            "M7",
            "M8",
            "M9"
          ]
        }
      ]
    },
    {
      "concept_id": "c8",
      "members": [
        {
          "atom": "human_C1.1.3",
          "run": "human",
          "node_id": "C1.1.3",
          "text": "湖北重要产茶区涵盖襄州南漳兴国军阳新通山江陵府鄂州蒲圻崇阳蕲州蕲春黄梅黄州麻城等地",
          "sources": [
            "M10",
            "M11"
          ]
        }
      ]
    },
    {
      "concept_id": "c9",
      "members": [
        {
          "atom": "human_C1.1.4",
          "run": "human",
          "node_id": "C1.1.4",
          "text": "湖北产茶区共十府州军在域内府州军总数中占比达百分之五十五",
          "sources": [
            "M11"
          ]
        }
      ]
    },
    {
      "concept_id": "c10",
      "members": [
        {
          "atom": "human_C1.1.5",
          "run": "human",
          "node_id": "C1.1.5",
          "text": "景祐元年天下户丁三分其一为产茶州军而湖北产茶比例远高于此",
          "sources": [
            "M12"
          ]
        }
      ]
    },
    {
      "concept_id": "c11",
      "members": [
        {
          "atom": "human_C1.1.7",
          "run": "human",
          "node_id": "C1.1.7",
          "text": "表一显示鄂州江陵府与蕲州三场茶叶种类较为丰富且质量上乘",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c12",
      "members": [
        {
          "atom": "human_C1.1.8",
          "run": "human",
          "node_id": "C1.1.8",
          "text": "因地方史料散佚与重量单位屡经更易北宋全国及各路茶叶产额难以确知",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c13",
      "members": [
        {
          "atom": "human_C1.1.9",
          "run": "human",
          "node_id": "C1.1.9",
          "text": "除夔州路所辖施州外湖北概行榷茶法便于将全域视作一体计算产量",
          "sources": []
        }
      ]
    },
    {
      "concept_id": "c14",
      "members": [
        {
          "atom": "human_C1.1.11",
          "run": "human",
          "node_id": "C1.1.11",
          "text": "夔州路自祖宗以来不榷茶始终行赋税折科与住税过税之税茶政策",
          "sources": [
            "M16",
            "M17"
          ]
        }
      ]
    },
    {
      "concept_id": "c15",
      "members": [
        {
          "atom": "human_C1.1.12",
          "run": "human",
          "node_id": "C1.1.12",
          "text": "范镇胪列蜀之产茶八处未及施州可推施州即便产茶产量亦极低",
          "sources": [
            "M18"
          ]
        }
      ]
    },
    {
      "concept_id": "c16",
      "members": [
        {
          "atom": "human_C1.1.13",
          "run": "human",
          "node_id": "C1.1.13",
          "text": "民岁输税愿折茶者谓之折税茶且民茶折税外匿不送官者没入论罪",
          "sources": [
            "M19",
            "M20"
          ]
        }
      ]
    },
    {
      "concept_id": "c17",
      "members": [
        {
          "atom": "human_C1.1.14",
          "run": "human",
          "node_id": "C1.1.14",
          "text": "天禧五年全国折税茶较至道年间增百余万斤后天禧末年又降至七十六万斤",
          "sources": [
            "M21"
          ]
        }
      ]
    },
    {
      "concept_id": "c18",
      "members": [
        {
          "atom": "human_C1.1.15",
          "run": "human",
          "node_id": "C1.1.15",
          "text": "官府要求茶园户承担每百斤二十至三十五斤耗茶湖北耗茶约二百七十七万斤",
          "sources": [
            "M22"
          ]
        }
      ]
    },
    {
      "concept_id": "c19",
      "members": [
        {
          "atom": "human_C1.1.16",
          "run": "human",
          "node_id": "C1.1.16",
          "text": "任土作贡的贡茶仅涉湖北少数产区江陵府有碧涧茶芽六百斤",
          "sources": [
            "M24"
          ]
        }
      ]
    },
    {
      "concept_id": "c20",
      "members": [
        {
          "atom": "human_C1.1.17",
          "run": "human",
          "node_id": "C1.1.17",
          "text": "食茶系官府转售民户之茶已计入买茶额故本文不另计",
          "sources": [
            "M25",
            "M26"
          ]
        }
      ]
    },
    {
      "concept_id": "c21",
      "members": [
        {
          "atom": "human_C1.1.18",
          "run": "human",
          "node_id": "C1.1.18",
          "text": "荆湖南北产茶州县铺户自造茶货与铺户私相交易致私茶问题严峻",
          "sources": [
            "M13",
            "M27"
          ]
        }
      ]
    },
    {
      "concept_id": "c22",
      "members": [
        {
          "atom": "human_C1.1.19",
          "run": "human",
          "node_id": "C1.1.19",
          "text": "宋太宗遣监察御史薛雄诣沿江诸州禁绝私茶反证民间私茶数量之大",
          "sources": [
            "M13"
          ]
        }
      ]
    },
    {
      "concept_id": "c23",
      "members": [
        {
          "atom": "human_C1.1.20",
          "run": "human",
          "node_id": "C1.1.20",
          "text": "学界估定私茶数量为买茶额半数至持平约五百万至一千万斤",
          "sources": [
            "M23"
          ]
        }
      ]
    },
    {
      "concept_id": "c24",
      "members": [
        {
          "atom": "human_C1.2.1",
          "run": "human",
          "node_id": "C1.2.1",
          "text": "北宋商业市场在空间上分为北方东南蜀川与关陇四域",
          "sources": [
            "M28"
          ]
        }
      ]
    },
    {
      "concept_id": "c25",
      "members": [
        {
          "atom": "human_C1.2.2",
          "run": "human",
          "node_id": "C1.2.2",
          "text": "湖北凭水网交织的交通北通汴京东连江淮南邻荆湖南路西溯汉江抵达关陇",
          "sources": [
            "M28"
          ]
        }
      ]
    },
    {
      "concept_id": "c26",
      "members": [
        {
          "atom": "human_C1.2.3",
          "run": "human",
          "node_id": "C1.2.3",
          "text": "学界多以官府与市场权利分配划分茶法可归为榷茶与通商两阶段",
          "sources": [
            "M29",
            "M30",
            "M31"
          ]
        }
      ]
    },
    {
