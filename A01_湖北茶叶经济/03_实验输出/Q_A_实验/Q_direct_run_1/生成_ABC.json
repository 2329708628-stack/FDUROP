  "C": [
    {
      "id": "C1.1.1",
      "parent": "B1.1",
      "anchor": "SRC_001_P01",
      "text": "蕲州、黄州等地形成主要茶叶生产基地。",
      "sources": [
        "SRC_001_P01"
      ]
    },
    {
      "id": "C1.1.2",
      "parent": "B1.1",
      "anchor": "SRC_013_P01",
      "text": "鄂州崇阳县多旷土，民以植茶为业。",
      "sources": [
        "SRC_013_P01"
      ]
    },
    {
      "id": "C1.1.3",
      "parent": "B1.1",
      "anchor": "SRC_005_P01",
      "text": "碧涧茶芽六百斤，显示湖北茶叶产量。",
      "sources": [
        "SRC_005_P01"
      ]
    },
    {
      "id": "C1.2.1",
      "parent": "B1.2",
      "anchor": "SRC_008_P07",
      "text": "泥水阻滞车牛，茶货通过转江船运输。",
      "sources": [
        "SRC_008_P07"
      ]
    },
    {
      "id": "C1.2.2",
      "parent": "B1.2",
      "anchor": "SRC_008_P08",
      "text": "贩卖蕲口、太湖茶货，依例纳税通行。",
      "sources": [
        "SRC_008_P08"
      ]
    },
    {
      "id": "C1.2.3",
      "parent": "B1.2",
      "anchor": "SRC_013_P02",
      "text": "受纳潭、鼎、岳、归等州片茶八十七万斤。",
      "sources": [
        "SRC_013_P02"
      ]
    },
    {
      "id": "C1.3.1",
      "parent": "B1.3",
      "anchor": "SRC_008_P01",
      "text": "茶盐之法系朝廷利柄，他司不敢侵紊。",
      "sources": [
        "SRC_008_P01"
      ]
    },
    {
      "id": "C1.3.2",
      "parent": "B1.3",
      "anchor": "SRC_008_P02",
      "text": "每百斤纳耗二十斤至三十五斤，规范税收。",
      "sources": [
        "SRC_008_P02"
      ]
    },
    {
      "id": "C1.3.3",
      "parent": "B1.3",
      "anchor": "SRC_008_P04",
      "text": "产茶州县居民私相交易，无引目管理。",
      "sources": [
        "SRC_008_P04"
      ]
    },
    {
      "id": "C2.1.1",
      "parent": "B2.1",
      "anchor": "SRC_016_P01",
      "text": "植产之地，崖必阳、圃必阴，适宜茶叶生长。",
      "sources": [
        "SRC_016_P01"
      ]
    },
    {
      "id": "C2.1.2",
      "parent": "B2.1",
      "anchor": "SRC_017_P02",
      "text": "上者生烂石，中者生栎壤，下者生黄土。",
      "sources": [
        "SRC_017_P02"
      ]
    },
    {
      "id": "C2.1.3",
      "parent": "B2.1",
      "anchor": "SRC_013_P01",
      "text": "鄂州崇阳县旷土植茶，自然条件优越。",
      "sources": [
        "SRC_013_P01"
      ]
    },
    {
      "id": "C2.2.1",
      "parent": "B2.2",
      "anchor": "SRC_008_P01",
      "text": "朝廷榷茶，利柄归官，控制贸易。",
      "sources": [
        "SRC_008_P01"
      ]
    },
    {
      "id": "C2.2.2",
      "parent": "B2.2",
      "anchor": "SRC_009_P04",
      "text": "民岁输税愿折茶者，谓之折税茶。",
      "sources": [
        "SRC_009_P04"
      ]
    },
    {
      "id": "C2.2.3",
      "parent": "B2.2",
      "anchor": "SRC_012_P27",
      "text": "罢禁榷后，官收租钱，商贾自相交易。",
      "sources": [
        "SRC_012_P27"
      ]
    },
    {
      "id": "C2.3.1",
      "parent": "B2.3",
      "anchor": "SRC_002_P01",
      "text": "人家每日不可阙者，茶叶为生活必需品。",
      "sources": [
        "SRC_002_P01"
      ]
    },
    {
      "id": "C2.3.2",
      "parent": "B2.3",
      "anchor": "SRC_009_P06",
      "text": "转致于西北，利尝至数倍，需求旺盛。",
      "sources": [
        "SRC_009_P06"
      ]
    },
    {
      "id": "C2.3.3",
      "parent": "B2.3",
      "anchor": "SRC_018_P01",
      "text": "茶之尚盛，本朝至祐陵时益穷极新出。",
      "sources": [
        "SRC_018_P01"
      ]
    },
    {
      "id": "C3.1.1",
      "parent": "B3.1",
      "anchor": "SRC_019_P01",
      "text": "湖北租茶岁计十万贯，鄂州敛三万九千缗。",
      "sources": [
        "SRC_019_P01"
      ]
    },
    {
      "id": "C3.1.2",
      "parent": "B3.1",
      "anchor": "SRC_008_P02",
      "text": "每百斤纳耗税，增加财政收入。",
      "sources": [
        "SRC_008_P02"
      ]
    },
    {
      "id": "C3.1.3",
      "parent": "B3.1",
      "anchor": "SRC_012_P08",
      "text": "县官之利甚博，商贾转致西北获利丰厚。",
      "sources": [
        "SRC_012_P08"
      ]
    },
    {
      "id": "C3.2.1",
      "parent": "B3.2",
      "anchor": "SRC_014_P02",
      "text": "破产亡家，怨嗟愁苦，民生受影响。",
      "sources": [
        "SRC_014_P02"
      ]
    },
    {
      "id": "C3.2.2",
      "parent": "B3.2",
      "anchor": "SRC_008_P11",
      "text": "佣力者众，贫民聚为寇盗，社会不稳定。",
      "sources": [
        "SRC_008_P11"
      ]
    },
    {
      "id": "C3.2.3",
      "parent": "B3.2",
      "anchor": "SRC_009_P07",
      "text": "湖北茶商群聚暴横，籍为兵号茶商军。",
      "sources": [
        "SRC_009_P07"
      ]
    },
    {
      "id": "C3.3.1",
      "parent": "B3.3",
      "anchor": "SRC_008_P05",
      "text": "遣监察御史禁绝私茶，政府强化管控。",
      "sources": [
        "SRC_008_P05"
      ]
    },
    {
      "id": "C3.3.2",
      "parent": "B3.3",
      "anchor": "SRC_009_P07",
      "text": "茶商军后多赖其用，影响军事部署。",
      "sources": [
        "SRC_009_P07"
      ]
    },
    {
      "id": "C3.3.3",
      "parent": "B3.3",
      "anchor": "SRC_012_P03",
      "text": "交引制度促进西北贸易，政策调整频繁。",
      "sources": [
        "SRC_012_P03"
      ]
    }
  ]
}