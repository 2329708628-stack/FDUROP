    "C_level": [
      {
        "id": "C1.1.1",
        "anchor": "P2",
        "text": "苏州政区演变与水利开发格局密切关联",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.2",
        "anchor": "P2",
        "text": "吴江塘路兴建对吴江嘉定县析置有牵动作用",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.3",
        "anchor": "P2",
        "text": "吴江县设置更多受政治军事交通因素影响",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.4",
        "anchor": "P2",
        "text": "嘉定县创设是高低乡水利开发农业垦殖的结果",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.5",
        "anchor": "P5",
        "text": "太湖地区开发从西部丘陵高地向东部平原集中",
        "sources": [
          "M2"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.6",
        "anchor": "P5",
        "text": "吴江县濒临太湖处吴淞江要地，属太湖东部平原",
        "sources": [
          "M3"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.7",
        "anchor": "P5",
        "text": "吴江地区四境皆湖泽，水面浮丘",
        "sources": [
          "M2"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.8",
        "anchor": "P5",
        "text": "平望隋唐以来淼然一波，居民鲜少",
        "sources": [
          "M3"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.9",
        "anchor": "P5",
        "text": "平望正当太湖之冲，遇霖雨则潦水涨溢",
        "sources": [
          "M4"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.10",
        "anchor": "P5",
        "text": "政府招募军民堤松江为路进行农业垦殖",
        "sources": [
          "M5"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.11",
        "anchor": "P5",
        "text": "吴江塘路与荻塘连接形成环湖堤岸屏障",
        "sources": [
          "M6"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.12",
        "anchor": "P5",
        "text": "唐朝在平望设驿站，周围仍为浅水沼泽",
        "sources": [
          "M6"
        ],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.13",
        "anchor": "P6",
        "text": "塘岸构建致泥沙淤积菱芦丛生渐成陆地",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.14",
        "anchor": "P6",
        "text": "政府军事屯田营田加速水域成陆",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.1.15",
        "anchor": "P6",
        "text": "人口聚集村落形成为吴江设县提供条件",
        "sources": [],
        "parent": "B1.1"
      },
      {
        "id": "C1.2.1",
        "anchor": "P8",
        "text": "梁开平三年钱氏奏请于松江置吴江县",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.2",
        "anchor": "P8",
        "text": "钱镠分吴县松陵镇置吴江县，初辖五乡",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.3",
        "anchor": "P8",
        "text": "钱氏在吴江立南北两城防遏使所负责军事",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.4",
        "anchor": "P8",
        "text": "吴江为吴越咽喉之地，南宋初屯兵八千",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.5",
        "anchor": "P8",
        "text": "吴江为苏嘉二郡间运道要冲势所必争",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.6",
        "anchor": "P8",
        "text": "吴江塘岸修建加速低乡水系网状化",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.7",
        "anchor": "P8",
        "text": "吴越增设吴江主要出于战略防御而非经济",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.8",
        "anchor": "P9",
        "text": "春秋至唐兵祸未及吴江提供稳定社会环境",
        "sources": [
          "M14"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.9",
        "anchor": "P9",
        "text": "吴越置撩浅军七八千人治河筑堤营田",
        "sources": [
          "M15"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.10",
        "anchor": "P9",
        "text": "撩浅卒带军事性质，吴江水田以营田屯田形式开发",
        "sources": [
          "M14"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.11",
        "anchor": "P9",
        "text": "入宋后设开江营数千人岁岁修治水利",
        "sources": [
          "M15"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.12",
        "anchor": "P9",
        "text": "南宋吴江成朝廷财赋供给地物阜民丰",
        "sources": [
          "M14"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.13",
        "anchor": "P9",
        "text": "宋代吴江22552户，元代达84300户",
        "sources": [
          "M18"
        ],
        "parent": "B1.2"
      },
      {
        "id": "C1.2.14",
        "anchor": "P9",
        "text": "吴江增设是钱氏军事部署，体现政治力非经济力",
        "sources": [],
        "parent": "B1.2"
      },
      {
        "id": "C1.3.1",
        "anchor": "P11",
        "text": "吴江增设加速长堤长桥建设促进垦殖",
        "sources": [
          "M19"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.2",
        "anchor": "P11",
        "text": "塘路长堤长桥阻碍太湖泄水",
        "sources": [
          "M20",
          "M21"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.3",
        "anchor": "P11",
        "text": "保运护漕凌驾于治水之上",
        "sources": [
          "M22"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.4",
        "anchor": "P11",
        "text": "郏亶认为吴江塘岸有御涛小功无卫民大效",
        "sources": [
          "M20"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.5",
        "anchor": "P11",
        "text": "单锷指出吴江长堤致震泽水溢壅灌三州",
        "sources": [
          "M21"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.6",
        "anchor": "P11",
        "text": "筑堤修桥解决运输但阻碍泄水加剧淤积",
        "sources": [
          "M22"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.7",
        "anchor": "P11",
        "text": "吴江筑岸后苏湖秀三州十年丰收仅二三",
        "sources": [
          "M23",
          "M24"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.8",
        "anchor": "P11",
        "text": "政府改长堤为长桥多置水洞求上通下泄",
        "sources": [
          "M25"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C1.3.9",
        "anchor": "P11",
        "text": "国家为漕运赋税之利未大动干戈",
        "sources": [
          "M25"
        ],
        "parent": "B1.3"
      },
      {
        "id": "C2.1.1",
        "anchor": "P14",
        "text": "嘉定县创设基于海域成陆与农业垦殖东推进",
        "sources": [
          "M26"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.2",
        "anchor": "P14",
        "text": "太湖东部沿海形成沙质冈身分高低乡",
        "sources": [
          "M26"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.3",
        "anchor": "P14",
        "text": "嘉定县属高乡，在旧冈身之东成陆开发较晚",
        "sources": [
          "M26"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.4",
        "anchor": "P14",
        "text": "唐宋海岸线迅速东移，海潮不及昆山吴江",
        "sources": [
          "M27"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.5",
        "anchor": "P14",
        "text": "嘉定境内塘浦泾港三千余条，种稻者十分之九",
        "sources": [
          "M27"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.6",
        "anchor": "P14",
        "text": "高乡通过人工沟渠堰闸斗门灌溉种稻",
        "sources": [
          "M28"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.7",
        "anchor": "P15",
        "text": "北宋中期后吴淞江拥塞，高乡灌溉艰难",
        "sources": [
          "M30"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.8",
        "anchor": "P15",
        "text": "练祁塘因吴淞江湮塞不复故道",
        "sources": [
          "M31"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.9",
        "anchor": "P15",
        "text": "人们铲平冈身开小泾小浜引潮水灌溉",
        "sources": [
          "M31"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.10",
        "anchor": "P15",
        "text": "水系变化加速成陆，稻作转菽麦木棉",
        "sources": [
          "M31"
        ],
        "parent": "B2.1"
      },
      {
        "id": "C2.1.11",
        "anchor": "P15",
        "text": "嘉定县在昆山东乡开发与水系恶化背景下创设",
        "sources": [],
        "parent": "B2.1"
      },
      {
        "id": "C2.2.1",
        "anchor": "P17",
        "text": "水利开发带动垦殖赋税人口但加重治理负担",
        "sources": [],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.2",
        "anchor": "P17",
        "text": "析置新县是应对县务繁剧的常见方式",
        "sources": [],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.3",
        "anchor": "P18",
        "text": "嘉定县旧属昆山县辖十四乡",
        "sources": [
          "M32"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.4",
        "anchor": "P18",
        "text": "嘉定十年赵彦橈王棐奏分五乡为嘉定县",
        "sources": [
          "M33"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.5",
        "anchor": "P18",
        "text": "分出五乡处东部滨海高乡地区",
        "sources": [],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.6",
        "anchor": "P19",
        "text": "昆山县境广袤东西相距二百里",
        "sources": [
          "M34"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.7",
        "anchor": "P19",
        "text": "县治偏西北，东七乡距县治一百四十里",
        "sources": [
          "M34"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.8",
        "anchor": "P19",
        "text": "东七乡民凭恃隔绝抗官不奉命令",
        "sources": [
          "M34"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.9",
        "anchor": "P20",
        "text": "东乡难治因县治远、市镇营寨少官府力量弱",
        "sources": [
          "M35"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.10",
        "anchor": "P20",
        "text": "东乡滨江傍海群盗横行，沙岛为藏匿基地",
        "sources": [
          "M36"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.11",
        "anchor": "P20",
        "text": "天赐盐场嘉定十五年才设置",
        "sources": [
          "M36"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.12",
        "anchor": "P20",
        "text": "豪民慢令无保正，保甲庇护形势之家",
        "sources": [
          "M37"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.13",
        "anchor": "P20",
        "text": "昆山东乡赋税额固定但拖欠转嫁西乡",
        "sources": [
          "M38",
          "M39"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.2.14",
        "anchor": "P20",
        "text": "围垦造成水利恶化，东乡赋税加重",
        "sources": [
          "M40"
        ],
        "parent": "B2.2"
      },
      {
        "id": "C2.3.1",
        "anchor": "P22",
        "text": "嘉定七年已有官员上书请析昆山东乡置县",
        "sources": [
          "M46"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.2",
        "anchor": "P22",
        "text": "嘉定十年赵彦橚王棐奏请置县获朝廷批准",
        "sources": [
          "M47",
          "M48"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.3",
        "anchor": "P22",
        "text": "高衍孙为嘉定首任知县，原任昆山县丞",
        "sources": [
          "M48"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.4",
        "anchor": "P22",
        "text": "嘉定创县是自上而下的政治行为非自下而上申请",
        "sources": [
          "M51",
          "M52"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.5",
        "anchor": "P22",
        "text": "朝廷选清强有心力者充知县一次",
        "sources": [
          "M47"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.6",
        "anchor": "P23",
        "text": "高衍孙采取怀柔措施不追究过往欠税",
        "sources": [
          "M53"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.7",
        "anchor": "P23",
        "text": "怀柔措施缓和官民冲突争取豪强支持",
        "sources": [
          "M53"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.8",
        "anchor": "P23",
        "text": "朝廷遣陈采赵汝备赵希照任县丞主簿县尉",
        "sources": [
          "M54"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.9",
        "anchor": "P24",
        "text": "嘉定县衙营建：县百楹丞簿四十五尉五十五学宫四十",
        "sources": [
          "M55"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.10",
        "anchor": "P24",
        "text": "营建费朝廷五千缗本府一万缗苗税一万四千五百缗",
        "sources": [
          "M55"
        ],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.11",
        "anchor": "P25",
        "text": "中央平江府资助一万五千缗，二税留一万五千缗",
        "sources": [],
        "parent": "B2.3"
      },
      {
        "id": "C2.3.12",
        "anchor": "P25",
        "text": "嘉定富户未如庆元县乐于捐助",
        "sources": [],
        "parent": "B2.3"
      },
      {
        "id": "C2.4.1",
        "anchor": "P27",
        "text": "嘉定设县加快高乡垦殖与人口集聚",
        "sources": [
          "M56"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.2",
        "anchor": "P27",
        "text": "昆山主课户祥符间一万六，庆元间六万",
        "sources": [
          "M56"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.3",
        "anchor": "P27",
        "text": "嘉定创县分户三万，元至元间近七万",
        "sources": [
          "M57"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.4",
        "anchor": "P27",
        "text": "人口聚集过度垦殖破坏水系环境",
        "sources": [
          "M58"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.5",
        "anchor": "P27",
        "text": "练祁塘因吴淞江水量减少一岁开三岁壅",
        "sources": [
          "M59"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.6",
        "anchor": "P27",
        "text": "潮汐带泥易淤，需每年疏浚",
        "sources": [
          "M60"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.7",
        "anchor": "P27",
        "text": "高乡水利围垦致塘浦消失代以人工泾浜",
        "sources": [
          "M61"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.8",
        "anchor": "P27",
        "text": "种植结构由水稻转向棉豆杂粮",
        "sources": [
          "M62"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C2.4.9",
        "anchor": "P27",
        "text": "嘉定东境河港通海潮汐日淀浚工难",
        "sources": [
          "M63"
        ],
        "parent": "B2.4"
      },
      {
        "id": "C0.1",
        "anchor": "P29",
        "text": "吴江嘉定增设是苏州水利开发和人口聚集的成果",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.2",
        "anchor": "P29",
        "text": "吴江增设更多受政治军事交通因素影响",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.3",
        "anchor": "P29",
        "text": "嘉定创设基于滨海成陆但分县因县邑难治",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.4",
        "anchor": "P29",
        "text": "水利开发是政区增设的充分条件非唯一因素",
        "sources": [],
        "parent": "A0"
      },
      {
        "id": "C0.5",
        "anchor": "P29",
        "text": "官方施政安排与政策选择在政区调整中作用重要",
        "sources": [],
        "parent": "A0"
      }
    ]
  },
